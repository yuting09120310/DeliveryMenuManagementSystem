@model IReadOnlyList<DMMS.Web.Models.MenuVersion>
@{ ViewData["Title"] = "Uber Eats 菜單版本"; }
@functions {
    static string Fmt(DateTime dt)
    {
        var l = dt.ToLocalTime();
        return $"{l:yyyy年M月d日} {(l.Hour < 12 ? "上午" : "下午")}{(l.Hour % 12 == 0 ? 12 : l.Hour % 12)}點{l.Minute}分";
    }
}
<div class="d-flex justify-content-between align-items-center mb-3"><p class="text-muted mb-0">複製現有菜單即可開新版本，不需重新勾選商品。</p><a class="btn btn-primary" asp-action="Create">＋ 建立 UE 菜單</a></div>
<table class="table align-middle"><thead><tr><th>名稱</th><th>商品數</th><th>建立時間</th><th></th></tr></thead><tbody>@foreach (var v in Model) {<tr><td>@v.Name</td><td>@v.Products.Count</td><td>@Fmt(v.CreatedAt)</td><td class="text-nowrap"><a asp-action="Preview" asp-route-id="@v.Id">預覽</a>　<a asp-action="Build" asp-route-id="@v.Id">編輯</a>　<form asp-action="Copy" asp-route-id="@v.Id" method="post" class="d-inline" onsubmit="return confirm('複製此菜單為新版本？');"><button type="submit" class="btn btn-link btn-sm p-0 align-baseline">複製</button></form></td></tr>}</tbody></table>
