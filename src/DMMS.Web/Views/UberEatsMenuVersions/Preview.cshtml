@model DMMS.Web.ViewModels.MenuVersionPreviewViewModel
@{ ViewData["Title"] = "UE 匯出預覽"; }
<h2>@(string.IsNullOrWhiteSpace(Model.RegionName) ? "（未指定地區）" : Model.RegionName) ・ @Model.Version.Name</h2>
<p>工作表：@string.Join("、", Model.SheetNames)</p>
<p class="text-muted">@Model.PriceStats.Total 品項 ・ @Model.PriceStats.Defaulted 項使用預設價 ・ @Model.PriceStats.Zero 項 0 元</p>
@if (Model.Errors.Count > 0) {<div class="alert alert-danger"><strong>無法匯出</strong><ul>@foreach (var e in Model.Errors) {<li>@e</li>}</ul></div>}
@if (Model.Warnings.Count > 0) {<div class="alert alert-warning"><strong>警告</strong><ul>@foreach (var e in Model.Warnings) {<li>@e</li>}</ul></div>}
@if (Model.PriceStats.Defaulted > 0) {<div class="alert alert-warning">本區有 @Model.PriceStats.Defaulted 項商品未設定地區價，將以「預設基礎價」匯出。若要調整請到商品編輯頁的「地區定價」。</div>}
@if (Model.PriceStats.Zero > 0) {<div class="alert alert-warning">本區有 @Model.PriceStats.Zero 項商品價格為 0 元，請確認是否忘了填寫。</div>}
<table class="table"><thead><tr><th>Sheet</th><th>Row count</th></tr></thead><tbody>@foreach (var item in Model.RowCounts) {<tr><td>@item.Key</td><td>@item.Value</td></tr>}</tbody></table>
<a class="btn btn-secondary" asp-action="Build" asp-route-id="@Model.Version.Id">調整商品</a>@if (Model.Errors.Count == 0) {<form asp-action="Export" asp-route-id="@Model.Version.Id" method="post" class="d-inline ms-2"><button class="btn btn-primary">下載 Excel</button></form>}
