@model DMMS.Web.ViewModels.ProductEditViewModel
<form method="post" class="form-layout">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="panel"><div class="panel-title">基本資料</div><div class="form-grid"><div><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="EnglishName"></label><input asp-for="EnglishName" class="form-control" /></div><div><label asp-for="BasePrice"></label><input asp-for="BasePrice" class="form-control" step="1" /><span asp-validation-for="BasePrice" class="text-danger"></span></div><div><label asp-for="CategoryId">分類</label><select asp-for="CategoryId" class="form-select"><option value="">未分類</option>@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }</select></div><div class="full"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div><label asp-for="SourceExternalId"></label><input asp-for="SourceExternalId" class="form-control" /></div><div><label asp-for="SourceUuid"></label><input asp-for="SourceUuid" class="form-control" /></div><div class="form-check full"><input asp-for="IsEnabled" class="form-check-input" /><label asp-for="IsEnabled" class="form-check-label"></label></div></div></section>
<section class="panel"><div class="panel-heading"><div><div class="panel-title mb-0">尺寸與品號</div><p class="text-muted mb-0">可設定中杯／大杯、冷熱基礎品號與價格加價</p></div></div>@for (var i = 0; i < Model.Sizes.Count; i++) { <div class="size-row"><input asp-for="Sizes[i].Id" type="hidden" /><input asp-for="Sizes[i].SortOrder" type="hidden" /><div><label>尺寸</label><input asp-for="Sizes[i].Name" class="form-control" /></div><div><label>價格加價</label><input asp-for="Sizes[i].PriceAdjustment" class="form-control" step="1" /></div><div><label>ColdBaseCode</label><input asp-for="Sizes[i].ColdBaseCode" class="form-control" placeholder="冷飲品號" /></div><div><label>HotBaseCode</label><input asp-for="Sizes[i].HotBaseCode" class="form-control" placeholder="熱飲品號" /></div><div class="form-check size-enabled"><input asp-for="Sizes[i].IsEnabled" class="form-check-input" /><label class="form-check-label">啟用</label></div></div> }</section>
<section class="panel preview-box"><div class="panel-title">ExternalData 預覽</div><p class="mb-0"><code>@Model.ExternalDataPreview</code></p><small class="text-muted">目前預覽尺寸冷／熱基礎品號；特口與加料 ExternalData 將於下一切片配置。</small></section>
<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">儲存商品</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }