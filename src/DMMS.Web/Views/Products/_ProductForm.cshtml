@model DMMS.Web.ViewModels.ProductEditViewModel
@using DMMS.Web.Models
<form method="post" class="form-layout">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="panel"><div class="panel-title">基本資料</div><div class="form-grid"><div><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="EnglishName"></label><input asp-for="EnglishName" class="form-control" /></div><div><label asp-for="BasePrice"></label><input asp-for="BasePrice" class="form-control" step="1" /><span asp-validation-for="BasePrice" class="text-danger"></span></div><div class="full"><label asp-for="CategoryIds">商品分類（可多選）</label><div class="cat-checkbox-grid">@foreach (var c in Model.Categories) { var catChecked = Model.CategoryIds.Contains(c.Id); <label class="choice-pill"><input type="checkbox" name="CategoryIds" value="@c.Id" @(catChecked ? "checked" : "") /> <span>@c.Name</span></label> }</div></div><div class="full"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="form-check full"><input asp-for="IsEnabled" class="form-check-input" /><label asp-for="IsEnabled" class="form-check-label"></label></div></div></section>

<section class="panel"><div class="panel-title">地區定價</div>
@if (!Model.RegionPrices.Any()) { <p class="text-muted mb-0">尚未建立任何地區，請先到「地區管理」新增。</p> } else {
<div class="region-price-grid">
@for (var i = 0; i < Model.RegionPrices.Count; i++) {
    <div class="region-price-row">
        <input asp-for="RegionPrices[i].RegionId" type="hidden" />
        <input asp-for="RegionPrices[i].ModifiedAt" type="hidden" class="region-modified" />
        <div class="region-name">@Model.RegionPrices[i].RegionName</div>
        <input asp-for="RegionPrices[i].Price" class="form-control region-price-input" step="1" data-default="@Model.BasePrice.ToString("0.##")" placeholder="預設 @Model.BasePrice.ToString("N0")" />
        <button type="button" class="btn btn-sm btn-outline-secondary reset-price-btn">用預設價</button>
        <span class="region-price-info small text-muted"></span>
        <span asp-validation-for="RegionPrices[i].Price" class="text-danger"></span>
    </div>
}
</div>
}
</section>

<section class="panel"><div class="panel-heading"><div><div class="panel-title mb-0">尺寸與品號</div><p class="text-muted mb-0">設定中杯／大杯、冷熱基礎品號與價格加價。若商品沒有多尺寸，保留一列即可。</p></div></div>@for (var i = 0; i < Model.Sizes.Count; i++) { <div class="size-row"><input asp-for="Sizes[i].Id" type="hidden" /><input asp-for="Sizes[i].SortOrder" type="hidden" /><div><label>尺寸</label><input asp-for="Sizes[i].Name" class="form-control" /></div><div><label>價格加價</label><input asp-for="Sizes[i].PriceAdjustment" class="form-control" step="1" /></div><div><label>ColdBaseCode</label><input asp-for="Sizes[i].ColdBaseCode" class="form-control" placeholder="冷飲品號" /></div><div><label>HotBaseCode</label><input asp-for="Sizes[i].HotBaseCode" class="form-control" placeholder="熱飲品號" /></div><div class="form-check size-enabled"><input asp-for="Sizes[i].IsEnabled" class="form-check-input" /><label class="form-check-label">啟用</label></div></div> }
</section>

@if (Model.GroupChoices.Any()) {
<section class="panel"><div class="panel-heading"><div><div class="panel-title mb-0">可用特口（冰度／甜度／溫度）</div></div></div>
@foreach (var grp in Model.GroupChoices) {
    <div class="choice-group"><div class="choice-group-title">@grp.GroupName</div>
    @foreach (var opt in grp.Options) {
        var checkedAttr = Model.SpecialOptionIds.Contains(opt.Id);
        <label class="choice-pill"><input type="checkbox" name="SpecialOptionIds" value="@opt.Id" @(checkedAttr ? "checked" : "") /> <span>@opt.Name</span></label>
    }
    </div>
}
</section>
} else {
<section class="panel"><div class="panel-title">可用特口</div><p class="text-muted mb-0">尚未建立任何特口群組。請先到「特口群組（冰度/甜度）」新增。</p></section>
}

<section class="panel"><div class="panel-heading"><div><div class="panel-title mb-0">可用加料</div></div></div>
@if (!Model.AvailableAddOns.Any()) { <div class="empty-state">尚未建立加料主檔，請先到「加料管理」新增。</div> } else {
<div class="addon-choice-grid">
@foreach (var ao in Model.AvailableAddOns) {
    var checkedAttr = Model.AddOnIds.Contains(ao.Id);
    <label class="choice-pill addon-choice"><input type="checkbox" name="AddOnIds" value="@ao.Id" @(checkedAttr ? "checked" : "") /> <span>@ao.Name</span>@if (ao.IcedOnly) { <span class="badge text-bg-info">僅冰</span> }@if (ao.FixedRatio) { <span class="badge text-bg-secondary">固定比例</span> }</label>
}
</div>
}
</section>

<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">儲存商品</button></div></form>
<script>
(function () {
    function fmt(n) { return 'NT$' + Number(n).toLocaleString('zh-TW'); }
    function sync(row) {
        var input = row.querySelector('.region-price-input');
        var info = row.querySelector('.region-price-info');
        if (!input || !info) return;
        var def = parseFloat(input.getAttribute('data-default') || '0');
        var raw = (input.value || '').trim();
        var mod = row.querySelector('.region-modified');
        var modTxt = mod && mod.value ? '（最後修改：' + new Date(mod.value).toLocaleString('zh-TW') + '）' : '';
        if (raw === '') { info.textContent = '目前套用 ' + fmt(def) + '（預設）' + modTxt; }
        else { var v = parseFloat(raw); info.textContent = isNaN(v) ? '請輸入數字' : '目前套用 ' + fmt(v) + modTxt; }
    }
    document.querySelectorAll('.region-price-row').forEach(function (row) {
        var input = row.querySelector('.region-price-input');
        var btn = row.querySelector('.reset-price-btn');
        if (input) { input.addEventListener('input', function () { sync(row); }); }
        if (btn) { btn.addEventListener('click', function () { input.value = ''; sync(row); }); }
        sync(row);
    });
})();
</script>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
