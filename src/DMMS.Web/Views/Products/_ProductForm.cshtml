@model DMMS.Web.ViewModels.ProductEditViewModel
@using DMMS.Web.Models
<form method="post" class="form-layout">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="panel"><div class="panel-title">基本資料</div><div class="form-grid"><div><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="EnglishName"></label><input asp-for="EnglishName" class="form-control" /></div><div><label asp-for="BasePrice"></label><input asp-for="BasePrice" class="form-control" step="1" /><span asp-validation-for="BasePrice" class="text-danger"></span></div><div><label asp-for="CategoryId">分類</label><select asp-for="CategoryId" class="form-select"><option value="">未分類</option>@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }</select></div><div class="full"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div><label asp-for="SourceExternalId"></label><input asp-for="SourceExternalId" class="form-control" /></div><div><label asp-for="SourceUuid"></label><input asp-for="SourceUuid" class="form-control" /></div><div class="form-check full"><input asp-for="IsEnabled" class="form-check-input" /><label asp-for="IsEnabled" class="form-check-label"></label></div></div></section>

<section class="panel"><div class="panel-heading"><div><div class="panel-title mb-0">尺寸與品號</div><p class="text-muted mb-0">設定中杯／大杯、冷熱基礎品號與價格加價。若商品沒有多尺寸，保留一列即可。</p></div></div>@for (var i = 0; i < Model.Sizes.Count; i++) { <div class="size-row"><input asp-for="Sizes[i].Id" type="hidden" /><input asp-for="Sizes[i].SortOrder" type="hidden" /><div><label>尺寸</label><input asp-for="Sizes[i].Name" class="form-control" /></div><div><label>價格加價</label><input asp-for="Sizes[i].PriceAdjustment" class="form-control" step="1" /></div><div><label>ColdBaseCode</label><input asp-for="Sizes[i].ColdBaseCode" class="form-control" placeholder="冷飲品號" /></div><div><label>HotBaseCode</label><input asp-for="Sizes[i].HotBaseCode" class="form-control" placeholder="熱飲品號" /></div><div class="form-check size-enabled"><input asp-for="Sizes[i].IsEnabled" class="form-check-input" /><label class="form-check-label">啟用</label></div></div> }</section>

@if (Model.GroupChoices.Any()) {
<section class="panel"><div class="panel-heading"><div><div class="panel-title mb-0">可用特口（冰度／甜度／溫度）</div><p class="text-muted mb-0">勾選這個飲品可以選擇哪些特口。配置是「商品層級」：勾選後各尺寸都會套用。</p></div></div>
@foreach (var grp in Model.GroupChoices) {
    <div class="choice-group"><div class="choice-group-title">@grp.GroupName <small class="text-muted">可選 @grp.Min ～ @(grp.Max == int.MaxValue ? "多" : grp.Max.ToString()) 項</small></div>
    @foreach (var opt in grp.Options) {
        var checkedAttr = Model.SpecialOptionIds.Contains(opt.Id);
        <label class="choice-pill"><input type="checkbox" name="SpecialOptionIds" value="@opt.Id" @(checkedAttr ? "checked" : "") /> <span>@opt.Name</span><small>@opt.KindLabel</small></label>
    }
    </div>
}
</section>
} else {
<section class="panel"><div class="panel-title">可用特口</div><p class="text-muted mb-0">尚未建立任何特口群組。請先到「特口群組（冰度/甜度）」新增。</p></section>
}

<section class="panel"><div class="panel-heading"><div><div class="panel-title mb-0">加料配置（可依尺寸覆寫品號／價格）</div><p class="text-muted mb-0">勾選可用加料。若不同尺寸品號不同（如醇香蜂蜜：中杯 <code>@@IT1812(20)</code>、大杯 <code>@@IT1836(40)</code>），在該尺寸列修改品號即可。</p></div></div>
@if (!Model.AvailableAddOns.Any()) { <div class="empty-state">尚未建立加料主檔，請先到「加料管理」新增。</div> } else {
<table class="table align-middle addon-table"><thead><tr><th>加料</th>@foreach (var s in Model.Sizes.Where(x => !string.IsNullOrWhiteSpace(x.Name))) { <th>@s.Name</th> }</tr></thead><tbody>
@foreach (var ao in Model.AvailableAddOns) {
    var rows = Model.AddOns.Where(r => r.AddOnId == ao.Id).ToList();
    if (!rows.Any()) continue;
    var anyOn = rows.Any(r => r.IsEnabled);
    <tr data-addon-id="@ao.Id"><td class="addon-name-cell"><label class="choice-pill"><input type="checkbox" class="addon-master-check" data-addon-id="@ao.Id" @(anyOn ? "checked" : "") /> <span>@ao.Name</span></label><div class="small text-muted">主檔：<code>@ao.ExternalData</code> NT$@ao.Price</div></td>
    @for (var si = 0; si < Model.Sizes.Count; si++) {
        var size = Model.Sizes[si];
        if (string.IsNullOrWhiteSpace(size.Name)) continue;
        var row = rows.FirstOrDefault(r => r.SizeName == size.Name);
        if (row is null) continue;
        var idx = Model.AddOns.IndexOf(row);
        <td class="addon-cell" data-size-name="@size.Name">
            <input type="hidden" asp-for="AddOns[@idx].Id" />
            <input type="hidden" asp-for="AddOns[@idx].AddOnId" />
            <input type="hidden" asp-for="AddOns[@idx].SizeName" />
            <input type="hidden" asp-for="AddOns[@idx].AddOnName" />
            <label class="check-line"><input type="checkbox" class="addon-size-check" asp-for="AddOns[@idx].IsEnabled" /> 啟用</label>
            <div class="small text-muted">品號</div>
            <input asp-for="AddOns[@idx].ExternalData" class="form-control form-control-sm addon-code" placeholder="@@IT1812(20)" />
            <div class="small text-muted mt-1">價格</div>
            <input asp-for="AddOns[@idx].Price" class="form-control form-control-sm addon-price" type="number" step="1" min="0" />
            <div class="small text-muted">@row.DefaultExternalData · 預設 NT$@row.DefaultPrice</div>
        </td>
    }
    </tr>
}
</tbody></table>
<p class="text-muted small">上方「主檔」為加料主檔的預設品號與價格；在每格修改即為此尺寸的覆寫值（用於匯出）。</p>
}
</section>

<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">儲存商品</button></div></form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
document.addEventListener('DOMContentLoaded', function () {
    // 加料：列首 master checkbox 連動所有尺寸格
    document.querySelectorAll('.addon-master-check').forEach(function (master) {
        master.addEventListener('change', function () {
            var tr = master.closest('tr[data-addon-id]');
            tr.querySelectorAll('.addon-size-check').forEach(function (cb) { cb.checked = master.checked; });
        });
    });
    // 個別尺寸取消時，同步 master 狀態
    document.querySelectorAll('.addon-size-check').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var tr = cb.closest('tr[data-addon-id]');
            var master = tr.querySelector('.addon-master-check');
            var all = Array.prototype.map.call(tr.querySelectorAll('.addon-size-check'), function (x) { return x.checked; });
            master.checked = all.some(Boolean);
        });
    });
});
</script>
}
