@model DMMS.Web.ViewModels.ProductListViewModel
@{ ViewData["Title"] = "商品管理"; }
@if (Model.DataError is not null) { <div class="alert alert-warning">@Model.DataError</div> }
<div class="panel"><div class="panel-heading"><div><h2>商品列表</h2><p class="text-muted mb-0">管理商品基本資料、分類與尺寸品號</p></div><a class="btn btn-primary" asp-action="Create">＋ 新增商品</a></div>
@if (!Model.Products.Any()) { <div class="empty-state">尚無商品資料，請先新增第一個商品。</div> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>商品</th><th>分類</th><th>基礎價格</th><th>尺寸</th><th>狀態</th><th></th></tr></thead><tbody>@foreach (var p in Model.Products) { <tr><td><a class="fw-semibold" asp-action="Edit" asp-route-id="@p.Id">@p.Name</a><div class="small text-muted">@p.EnglishName</div></td><td>@p.Categories</td><td>NT$ @p.BasePrice.ToString("N0")</td><td>@p.SizeCount 種 @if (p.MissingCode) { <span class="badge text-bg-warning">缺品號</span> }</td><td><span class="status @(p.IsEnabled ? "on" : "off")">@(p.IsEnabled ? "啟用" : "停用")</span></td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">編輯</a></td></tr> }</tbody></table></div> }</div>
