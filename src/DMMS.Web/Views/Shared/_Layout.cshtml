<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 外送菜單管理系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="admin-shell">
<aside class="sidebar"><div class="brand">外送菜單管理系統</div><div class="sidebar-label">管理導覽</div>
<a class="side-link" asp-controller="Dashboard" asp-action="Index">總覽 Dashboard</a>
<div class="sidebar-label">主檔資料</div>
<a class="side-link" asp-controller="Categories" asp-action="Index">分類管理</a>
<a class="side-link" asp-controller="SpecialOptionGroups" asp-action="Index">特口群組（冰度/甜度）</a>
<a class="side-link" asp-controller="AddOns" asp-action="Index">加料管理</a>
<a class="side-link" asp-controller="Products" asp-action="Index">商品管理</a>
<div class="sidebar-label">菜單建置</div>
<a class="side-link" asp-controller="UberEatsMenuVersions" asp-action="Index">Uber Eats 菜單</a>
</aside>
<main class="content"><header class="topbar"><div><div class="eyebrow">ADMIN CONSOLE</div><h1>@ViewData["Title"]</h1></div></header>
@RenderBody()
<footer class="text-muted small mt-5">外送菜單管理系統 · 內部管理使用</footer></main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
