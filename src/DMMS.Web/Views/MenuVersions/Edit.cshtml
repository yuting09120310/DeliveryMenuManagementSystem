@model DMMS.Web.ViewModels.MenuVersionEditViewModel
@{ ViewData["Title"] = "菜單建置／UE 匯出"; }
<form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div>
<section class="panel"><div class="panel-title">版本設定</div><div class="form-grid"><div><label asp-for="Name"></label><input asp-for="Name" class="form-control" /></div><div><label asp-for="Platform"></label><input asp-for="Platform" class="form-control" /></div></div></section>
<section class="panel"><div class="panel-title">Uber Eats 店家設定（寫入 GlobalSettings／Menus sheet）</div>
<div class="form-grid">
<div><label asp-for="StoreUuid"></label><input asp-for="StoreUuid" class="form-control" placeholder="例如 59d870fa-c045-5906-935c-9f8a6adc265e" /><span class="text-muted small">UE 後台 → 設定 → 店家 UUID，首次匯出必填</span></div>
<div><label asp-for="MenuExternalId"></label><input asp-for="MenuExternalId" class="form-control" /></div>
<div><label asp-for="MenuDisplayName"></label><input asp-for="MenuDisplayName" class="form-control" /></div>
<div><label asp-for="OpenHours"></label><input asp-for="OpenHours" class="form-control" placeholder="10:30--20:00" /><span class="text-muted small">每日營業時間（一～日套用同一值）</span></div>
</div></section>
<h3>選取商品（匯出時依商品分類分組）</h3>
<div class="row">@foreach (var p in Model.Products) {<div class="col-md-4"><label class="border rounded p-2 d-block"><input type="checkbox" name="SelectedProductIds" value="@p.Id" checked="@Model.SelectedProductIds.Contains(p.Id)" /> @p.Name <small class="text-muted">(@p.Sizes.Count 尺寸)</small></label></div>}</div>
<button class="btn btn-primary mt-3">儲存並預覽</button></form>
