@model DMMS.Web.ViewModels.AddOnEditViewModel
<form method="post" class="form-layout">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="panel"><div class="panel-title">加料設定</div><div class="form-grid">
<div><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div><label asp-for="EnglishName"></label><input asp-for="EnglishName" class="form-control" /></div>
<div><label asp-for="Price"></label><input asp-for="Price" class="form-control" step="1" /><span asp-validation-for="Price" class="text-danger"></span><small class="text-muted">未依尺寸特化時的預設價</small></div>
<div><label asp-for="ExternalData"></label><input asp-for="ExternalData" class="form-control" placeholder="@@IT1810(19)" /><span asp-validation-for="ExternalData" class="text-danger"></span><small class="text-muted">預設品號，系統會自動補上 @@ 前綴</small></div>
<div class="form-check"><input asp-for="IcedOnly" class="form-check-input" /><label asp-for="IcedOnly" class="form-check-label"></label></div>
<div class="form-check"><input asp-for="FixedRatio" class="form-check-input" /><label asp-for="FixedRatio" class="form-check-label"></label></div>
<div class="form-check"><input asp-for="IsEnabled" class="form-check-input" /><label asp-for="IsEnabled" class="form-check-label"></label></div>
</div></section>

<section class="panel">
<div class="panel-heading"><h2 class="mb-0">依尺寸品號 <span class="text-muted fs-6 fw-normal">（選擇性）</span></h2><button type="button" class="btn btn-outline-primary btn-sm" id="add-size-btn">＋ 新增尺寸</button></div>
<div class="panel-hint">
<p class="mb-1">當不同尺寸的品號或價格不同時，請在此填寫；同尺寸共用一組品號的加料可留空，匯出時自動使用上方「預設品號」。</p>
<ul class="mb-0">
<li>範例：醇香蜂蜜</li>
<li>中杯：<code>@@IT1812(20)</code>，加購 NT$10</li>
<li>大杯：<code>@@IT1836(40)</code>，加購 NT$15</li>
</ul>
</div>
<div id="asize-wrap">
@for (var i = 0; i < Model.Sizes.Count; i++) {
    <div class="asize-row">
        <input asp-for="Sizes[i].Id" type="hidden" />
        <div><label>尺寸名稱</label><input asp-for="Sizes[i].SizeName" class="form-control" placeholder="中杯" /></div>
        <div><label>品號 ExternalData</label><input asp-for="Sizes[i].ExternalData" class="form-control" placeholder="@@IT1812(20)" /></div>
        <div><label>加購價格</label><input asp-for="Sizes[i].Price" class="form-control" step="1" min="0" /></div>
        <div class="chk"><label class="form-check-label"><input asp-for="Sizes[i].IsEnabled" class="form-check-input" /> 啟用</label></div>
        <button type="button" class="btn btn-sm btn-outline-danger remove-size-btn" title="移除">✕</button>
    </div>
}
</div>
</section>

<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">儲存加料</button></div>
</form>

<template id="asize-template">
    <div class="asize-row">
        <input type="hidden" data-field="Id" value="0" />
        <div><label>尺寸名稱</label><input class="form-control" data-field="SizeName" placeholder="中杯" /></div>
        <div><label>品號 ExternalData</label><input class="form-control" data-field="ExternalData" placeholder="@@IT1812(20)" /></div>
        <div><label>加購價格</label><input class="form-control" data-field="Price" step="1" min="0" value="0" /></div>
        <div class="chk"><label class="form-check-label"><input class="form-check-input" type="checkbox" data-field="IsEnabled" checked /> 啟用</label></div>
        <button type="button" class="btn btn-sm btn-outline-danger remove-size-btn" title="移除">✕</button>
    </div>
</template>
