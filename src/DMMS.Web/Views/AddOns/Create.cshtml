@model DMMS.Web.ViewModels.AddOnEditViewModel
@{ ViewData["Title"] = "新增加料"; }
<form method="post" class="form-layout">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="panel"><div class="panel-title">加料設定</div><div class="form-grid"><div><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="EnglishName"></label><input asp-for="EnglishName" class="form-control" /></div><div><label asp-for="Price"></label><input asp-for="Price" class="form-control" step="1" /><span asp-validation-for="Price" class="text-danger"></span></div><div><label asp-for="ExternalData"></label><input asp-for="ExternalData" class="form-control" placeholder="@@IT1810(19)" /><span asp-validation-for="ExternalData" class="text-danger"></span><small class="text-muted">系統會自動補上 @@ 前綴</small></div><div class="form-check"><input asp-for="IcedOnly" class="form-check-input" /><label asp-for="IcedOnly" class="form-check-label"></label></div><div class="form-check"><input asp-for="FixedRatio" class="form-check-input" /><label asp-for="FixedRatio" class="form-check-label"></label></div><div class="form-check"><input asp-for="IsEnabled" class="form-check-input" /><label asp-for="IsEnabled" class="form-check-label"></label></div></div></section>
<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">儲存加料</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
