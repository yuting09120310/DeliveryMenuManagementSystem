@model DMMS.Web.ViewModels.AddOnListViewModel
@{ ViewData["Title"] = "加料管理"; }
@if (TempData["Error"] is not null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@if (Model.DataError is not null) { <div class="alert alert-warning">@Model.DataError</div> }
<div class="panel"><div class="panel-heading"><div><h2>加料列表</h2><p class="text-muted mb-0">管理共用加料、@@ 品號與「依尺寸品號」（不同尺寸不同品號時在此填寫）</p></div><a class="btn btn-primary" asp-action="Create">＋ 新增加料</a></div>
@if (!Model.AddOns.Any()) { <div class="empty-state">尚無加料資料。請先建立加料（如珍珠、椰果），再配置到商品。</div> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>加料名稱</th><th>預設品號</th><th>依尺寸品號</th><th>屬性</th><th>使用</th><th>狀態</th><th></th></tr></thead><tbody>@foreach (var a in Model.AddOns) { <tr><td><a class="fw-semibold" asp-action="Edit" asp-route-id="@a.Id">@a.Name</a>@if (!string.IsNullOrWhiteSpace(a.EnglishName)) { <div class="small text-muted">@a.EnglishName</div> }</td><td><code>@a.ExternalDataDisplay</code><div class="small text-muted">NT$ @a.Price.ToString("N0")</div></td><td>@if (string.IsNullOrWhiteSpace(a.SizeSummary)) { <span class="text-muted small">沿用預設</span> } else { <span class="small">@a.SizeSummary</span> }</td><td>@if (a.IcedOnly) { <span class="badge text-bg-info">僅冰</span> } @if (a.FixedRatio) { <span class="badge text-bg-secondary">固定比例</span> }</td><td>@if (a.IsUsedByProduct) { <span class="badge text-bg-primary">使用中</span> } else { <span class="badge text-bg-secondary">未使用</span> }</td><td><span class="status @(a.IsEnabled ? "on" : "off")">@(a.IsEnabled ? "啟用" : "停用")</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@a.Id">編輯</a> <form method="post" asp-action="Delete" asp-route-id="@a.Id" class="d-inline" onsubmit="return confirm('確定刪除加料「@a.Name」？此動作無法復原。');">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger">刪除</button></form></td></tr> }</tbody></table></div> }</div>
