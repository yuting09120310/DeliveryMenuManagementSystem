@model DMMS.Web.ViewModels.CategoryEditViewModel
@{ ViewData["Title"] = "編輯分類"; }
<form method="post" class="form-layout">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="panel"><div class="panel-title">分類設定</div><div class="form-grid"><div><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="如：原茶系列" /><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="EnglishName"></label><input asp-for="EnglishName" class="form-control" placeholder="Classic Pure Tea" /></div><div><label asp-for="SortOrder"></label><input asp-for="SortOrder" class="form-control" type="number" step="1" /><span asp-validation-for="SortOrder" class="text-danger"></span></div></div></section>
<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">儲存分類</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
