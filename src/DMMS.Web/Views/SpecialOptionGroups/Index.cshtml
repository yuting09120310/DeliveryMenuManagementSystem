@model DMMS.Web.ViewModels.SpecialOptionGroupListViewModel
@{ ViewData["Title"] = "特口群組管理"; }
@if (TempData["Error"] is not null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@if (Model.DataError is not null) { <div class="alert alert-warning">@Model.DataError</div> }
<div class="panel"><div class="panel-heading"><div><h2>特口群組列表</h2><p class="text-muted mb-0">管理共用選項群組：冰度、甜度、溫度等，供商品批次套用</p></div><a class="btn btn-primary" asp-action="Create">＋ 新增群組</a></div>
@if (!Model.Groups.Any()) { <div class="empty-state">尚無特口群組。請先建立冰度／甜度等群組，再加入群組選項。</div> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>群組名稱</th><th>Min / Max</th><th>選項數</th><th>啟用中</th><th>使用狀態</th><th></th></tr></thead><tbody>@foreach (var g in Model.Groups) { <tr><td><a class="fw-semibold" asp-action="Edit" asp-route-id="@g.Id">@g.Name</a></td><td>@g.Min / @g.Max</td><td>@g.OptionCount</td><td>@g.EnabledOptionCount</td><td>@if (g.HasProductLinks) { <span class="badge text-bg-primary">已被商品使用</span> } else { <span class="badge text-bg-secondary">未使用</span> }</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@g.Id">編輯</a> <form method="post" asp-action="Delete" asp-route-id="@g.Id" class="d-inline" onsubmit="return confirm('確定刪除群組「@g.Name」？此動作無法復原。');">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger">刪除</button></form></td></tr> }</tbody></table></div> }</div>
