@model DMMS.Web.ViewModels.RegionEditViewModel
@{ ViewData["Title"] = "地區設定"; }
<form method="post" class="form-layout">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="panel"><div class="panel-title">地區設定</div>
<div class="form-grid">
    <div><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div><label asp-for="SortOrder"></label><input asp-for="SortOrder" class="form-control" type="number" /></div>
    <div class="form-check full"><input asp-for="IsEnabled" class="form-check-input" /><label asp-for="IsEnabled" class="form-check-label"></label><p class="text-muted small mb-0 ms-1 d-inline">停用後不出現在「建立 UE 菜單」的地區下拉，既有資料仍保留。</p></div>
</div>
@if (Model.Id > 0) { <p class="text-muted small mb-0 mt-2">目前此區有 @Model.PriceCount 項商品定價、@Model.MenuVersionCount 個菜單版本。</p> }
</section>
<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">儲存地區</button></div>
</form>
