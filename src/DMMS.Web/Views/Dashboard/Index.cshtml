@model DMMS.Web.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "營運總覽"; }
@functions {
    static string Fmt(DateTime dt)
    {
        var l = dt.ToLocalTime();
        return $"{l:yyyy年M月d日} {(l.Hour < 12 ? "上午" : "下午")}{(l.Hour % 12 == 0 ? 12 : l.Hour % 12)}點{l.Minute}分";
    }
}
@if (Model.DataError is not null) { <div class="alert alert-warning">@Model.DataError</div> }
<section class="panel"><div class="panel-title">主檔統計</div>
<div class="stat-grid">
    <div class="stat-card"><span>商品總數</span><strong>@Model.ProductCount</strong><em class="d-block text-muted small mt-1">啟用 @Model.EnabledProductCount</em></div>
    <div class="stat-card"><span>特口選項</span><strong>@Model.SpecialOptionCount</strong><em class="d-block text-muted small mt-1">冰度 @Model.IceOptionCount · 甜度 @Model.SweetOptionCount</em></div>
    <div class="stat-card"><span>加料數</span><strong>@Model.AddOnCount</strong><em class="d-block text-muted small mt-1">可加價配料</em></div>
    <div class="stat-card"><span>分類數</span><strong>@Model.CategoryCount</strong><em class="d-block text-muted small mt-1">匯出分組依據</em></div>
</div>
</section>
<section class="panel mt-4"><div class="panel-title">匯出前檢查</div>
@if (Model.MissingCodeProductCount == 0) {
    <div class="d-flex align-items-center gap-2"><span class="badge text-bg-success">就緒</span><span class="text-muted">所有商品尺寸品號齊全，可直接匯出。</span></div>
} else {
    <div class="d-flex align-items-center gap-2"><span class="badge text-bg-danger">@Model.MissingCodeProductCount 項待處理</span><span class="text-muted">@string.Join("、", Model.MissingCodeProductNames) 缺少尺寸品號。</span></div>
}
</section>
<section class="panel mt-4"><div class="panel-heading"><div><div class="panel-title mb-0">Uber Eats 菜單</div></div><a class="btn btn-primary btn-sm" asp-controller="UberEatsMenuVersions" asp-action="Create">＋ 建立 UE 菜單</a></div>
@if (Model.RecentVersions.Count == 0) {
    <p class="text-muted mb-0">尚未建立菜單版本，點右上「＋ 建立 UE 菜單」開始。</p>
} else {
    <table class="table align-middle"><thead><tr><th>版本</th><th>商品數</th><th>建立時間</th><th></th></tr></thead><tbody>
    @foreach (var v in Model.RecentVersions) {
        <tr><td>@v.Name</td><td>@v.Products.Count</td><td>@Fmt(v.CreatedAt)</td>
        <td><a asp-controller="UberEatsMenuVersions" asp-action="Preview" asp-route-id="@v.Id">預覽</a>　<a asp-controller="UberEatsMenuVersions" asp-action="Build" asp-route-id="@v.Id">編輯</a>　<form asp-controller="UberEatsMenuVersions" asp-action="Copy" asp-route-id="@v.Id" method="post" class="d-inline" onsubmit="return confirm('複製此菜單為新版本？');"><button type="submit" class="btn btn-link btn-sm p-0 align-baseline">複製</button></form></td></tr>
    }</tbody></table>
}
</section>
